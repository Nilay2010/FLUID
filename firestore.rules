rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isSignedIn() && isValidId(userId) && (
        isOwner(userId) ||
        // Allow updating followersCount when another user follows/unfollows
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
      );
      allow delete: if isOwner(userId);

      // Interaction telemetry signals subcollection
      match /signals/{signalId} {
        allow read, write: if isSignedIn() && isValidId(userId) && isOwner(userId);
      }
    }

    // Feed media posts
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(postId) && (
        // Author can update caption or details
        resource.data.authorId == request.auth.uid ||
        // Any signed-in user can like/unlike or increment comment count
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy', 'commentsCount'])
      );
      allow delete: if isSignedIn() && isValidId(postId) &&
        resource.data.authorId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(postId);
        allow create: if isSignedIn() && isValidId(postId) && isValidId(commentId) &&
          request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        );
      }
    }

    // Stories (24h ephemeral)
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(storyId) &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(storyId) && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
      );
      allow delete: if isSignedIn() && isValidId(storyId) &&
        resource.data.authorId == request.auth.uid;
    }

    // Direct message threads
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) &&
        request.auth.uid in resource.data.participants;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(chatId) &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && isValidId(chatId) &&
        request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && isValidId(chatId) &&
        request.auth.uid in resource.data.participants;

      // Messages inside direct message chat
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(chatId) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && isValidId(chatId) && isValidId(messageId) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(chatId) && isValidId(messageId) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'status', 'readAt']);
        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(messageId) &&
          resource.data.senderId == request.auth.uid;
      }
    }
  }
}
